                    "onActionPerformed": {
                      "type": "script",
                      "scope": "G",
                      "config": {
                        "script": "\tfrom java.lang import Exception as JavaException\n\tfrom washheat import service\n\ttry:\n\t    if not self.session.props.auth.authenticated:\n\t        raise ValueError(\"Sign in to record an attributable operator decision.\")\n\t    run_id = self.getSibling(\"DecisionRun\").props.text\n\t    rows = [row for row in self.view.custom.runs if row[\"run_id\"] == run_id]\n\t    if len(rows) != 1:\n\t        raise ValueError(\"Refresh and select a run from the displayed snapshot.\")\n\t    service.record_decision(run_id, 'UNLOAD_OK', self.getSibling(\"DecisionReason\").props.text, self.session.props.auth.user.userName, rows[0][\"version\"])\n\t    self.view.custom.runs = service.list_runs()\n\t    self.view.custom.message = \"Operator decision saved in Ignition.\"\n\texcept (Exception, JavaException) as error:\n\t    self.view.custom.message = \"FAILED: \" + str(error)"
                      }
                    }
                  }
                }
              },
