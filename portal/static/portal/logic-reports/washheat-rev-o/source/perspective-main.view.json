          "script": "\tfrom java.lang import Exception as JavaException\n\tfrom washheat import service\n\ttry:\n\t    self.custom.runs = service.list_runs()\n\t    records = service.list_records()\n\t    self.custom.recordPreview = system.util.jsonEncode(records[0], 2) if records else \"No completed wash records yet.\"\n\t    self.custom.message = \"Database snapshot refreshed. Numbered workflow state is owned by Ignition.\"\n\texcept (Exception, JavaException) as error:\n\t    self.custom.message = \"FAILED: \" + str(error)\n\t    self.custom.runs = []"
        }
      }
    }
